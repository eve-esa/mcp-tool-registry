# Public CEDA OpenSearch endpoint.
CEDA_OPENSEARCH_URL=https://archive.opensearch.ceda.ac.uk/opensearch

# Request timeout in seconds and HTTPS certificate verification.
HTTP_REQUEST_TIMEOUT=10
HTTP_REQUEST_TLS_VERIFY=true

# User-Agent sent to Nominatim; use an addressable project identifier.
NOMINATIM_USER_AGENT=ceda-opensearch-mcp/1.0
